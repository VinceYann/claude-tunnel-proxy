#!/bin/bash
# ============================================================
#  Claude Tunnel Proxy — 一键启动（Finder 双击运行）
#  --------------------------------------------
#  双击后自动启动代理 + SSH 反向隧道，放到后台常驻。
#  启动完成即可关闭本窗口，隧道继续在后台运行。
# ============================================================

cd "$(dirname "$0")"

echo "============================================"
echo "  Claude Tunnel Proxy — 一键启动"
echo "============================================"
echo ""

./tunnel-daemon.sh start
rc=$?

echo ""
if [[ $rc -eq 0 ]]; then
    echo "隧道已在后台常驻，本窗口可安全关闭。"
    echo "  · 停止隧道: ./tunnel-daemon.sh stop"
    echo "  · 菜单栏控制: 打开 TunnelBar.app"
else
    echo "启动失败，请根据上方日志排查。"
fi
echo ""
echo "按回车键关闭本窗口…"
read -r _
