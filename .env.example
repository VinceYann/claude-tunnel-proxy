# ============================================================
#  Claude Code tunnel proxy — configuration
#  ============================================================
#  Copy this file to .env and fill in your own values.
#  .env is git-ignored and will never be committed.
# ============================================================

# ---- Remote server ----
# SSH host alias (from ~/.ssh/config) or user@host
SSH_HOST="your-server-alias"

# ---- Local proxy ----
# Bind address and port for the local HTTP CONNECT proxy
PROXY_HOST="127.0.0.1"
PROXY_PORT="1080"

# ---- Remote port (optional) ----
# Port on the remote side that the reverse tunnel binds to.
# Defaults to the same value as PROXY_PORT.
REMOTE_PORT="1080"
